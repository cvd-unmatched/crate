# Required. Personal access token from https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Optional. Extra host names you'll open Crate by, comma separated (no port = any port).
# localhost, 127.0.0.1 and [::1] always work.
# ALLOWED_HOSTS=homelab,homelab.your-tailnet.ts.net,100.101.102.103

# Optional, for running without Docker. compose.yaml sets these for the container.
# PORT=5178
# HOST=127.0.0.1
# DATA_DIR=./data
